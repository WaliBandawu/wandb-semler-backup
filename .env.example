# Copy this file to .env and fill in real values.
# .env is gitignored - it will never be committed.

# W&B API key. Read automatically by the wandb SDK - no code change
# needed. Get yours at https://wandb.ai/authorize
WANDB_API_KEY=

# Semler SFTP destination. Falls back to reading
# /home/ubuntu/.semler_sftp_credentials.json (JSON: host/port/username/
# password) if these aren't set - see sftp_backup_lib.py.
SEMLER_SFTP_HOST=files.semlerscientific.net
SEMLER_SFTP_PORT=22
SEMLER_SFTP_USERNAME=
SEMLER_SFTP_PASSWORD=

# This account also requires TOTP two-factor authentication after the
# password. Set this to its permanent TOTP seed (the base32 string
# shown once when 2FA was enrolled, e.g. next to the QR code - NOT a
# rotating 6-digit code, which expires in ~30s and can't be reused).
# With this set, every SFTP connection generates its own valid code
# automatically - no one needs to type a code, ever. Without it, any
# connection attempt fails with a clear error explaining this.
SEMLER_SFTP_TOTP_SECRET=

# Local staging directory the backup scripts read/write to before
# upload. Defaults to a wandb_backups/ folder next to the scripts
# if unset.
BACKUP_BASE_DIR=
